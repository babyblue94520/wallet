[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
# --- 基礎與連線 ---
skip-name-resolve
bind-address = 0.0.0.0
server-id = 1
max_connections = 4000
transaction-isolation = READ-COMMITTED
default-authentication-plugin = caching_sha2_password

# --- 日誌 (修正路徑避免崩潰) ---
# 建議讓 binlog 存在預設資料夾 /var/lib/mysql 下，這樣最保險
log-bin = mysql-bin
# log_bin_index 會自動生成，通常不需手動指定
binlog_expire_logs_seconds = 86400  # 縮短為 7 天，避免硬碟爆滿 (原本 30 天太久)

# --- 字元集與排序 (只在乎 character) ---
character-set-server = utf8mb4
# 移除 character-set-client-handshake 避免 8.0.45 的警告
# 移除 collation-server 讓系統自動處理

# --- 效能與安全性 ---
# 警告：0 代表高風險，若當機會丟失 1 秒數據。若求穩請改回 1。
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1
read_only = 0

# --- InnoDB 寫入效能 (不降低耐久度的優化) ---
# 目前容器可見記憶體約 8GB；若這台機器主要跑 MySQL，可把 buffer pool 設到 50~70% RAM。
# 寫入效能最常見瓶頸是 buffer pool 太小（預設只有 128MB）。
innodb_buffer_pool_size = 3G
innodb_buffer_pool_instances = 3

# Redo log 太小會導致頻繁 checkpoint，寫入吞吐會明顯下降
innodb_redo_log_capacity = 2G
innodb_log_buffer_size = 64M

# 避免雙重 page cache（OS page cache + InnoDB buffer pool）
innodb_flush_method = O_DIRECT

# SSD/本機磁碟常見可提高；若是慢速磁碟可先保守調小
innodb_io_capacity = 1000
innodb_io_capacity_max = 4000
innodb_page_cleaners = 3
innodb_read_io_threads = 8
innodb_write_io_threads = 8

# --- (選用) 以寫入吞吐為優先：可接受當機時丟資料 ---
# 風險：innodb_flush_log_at_trx_commit=2 可能丟 ~1 秒交易；sync_binlog=0 可能丟更多 binlog。
#innodb_flush_log_at_trx_commit = 2
#sync_binlog = 0

# --- (選用) 有大量並行小交易時，增加 group commit 以提升吞吐（會增加平均 commit latency） ---
#binlog_group_commit_sync_delay = 1000              # 1ms
#binlog_group_commit_sync_no_delay_count = 10
